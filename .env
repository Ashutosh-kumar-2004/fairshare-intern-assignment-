# ────────────────────────────────────────────────────────────────────────────
# SecureAgent — Environment Variables
# Copy this file to .env.local (frontend) and .env (backend) and fill in values.
# NEVER commit real secrets. NEVER use NEXT_PUBLIC_ for any secret.
# ────────────────────────────────────────────────────────────────────────────

# ── Frontend (Next.js) — .env.local ─────────────────────────────────────────
NEXTAUTH_SECRET=CHANGE_ME_32_CHARS_MIN_NEXTAUTH_SECRET
NEXTAUTH_URL=http://localhost:3000

# GitHub OAuth App credentials (create at github.com/settings/developers)
GITHUB_CLIENT_ID=Ov23li3mlq6bQ8v1ewd5l
GITHUB_CLIENT_SECRET=1b41c2a4b8b970a57fcaa1dd04a714217024e6a3

# BFF → FastAPI (server-side ONLY — no NEXT_PUBLIC_ prefix)
BACKEND_URL=http://localhost:8000
BACKEND_SECRET=CHANGE_ME_32_CHARS_MIN_BACKEND_SECRET
JWT_EXPIRY_SECONDS=600

# ── Backend (FastAPI) — .env ─────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./secureagent.db
# Phase 6: DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/secureagent

REDIS_URL=redis://localhost:6379/0

# Must match BACKEND_SECRET above
BACKEND_SECRET=CHANGE_ME_32_CHARS_MIN_BACKEND_SECRET

# Fernet key for encrypting GitHub tokens at rest
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Frontend URL for CORS allowlist
FRONTEND_URL=http://localhost:3000

# ── Workspace ─────────────────────────────────────────────────────────────────
# Windows: D:\MEETmux\secureagent\workspaces
# Linux/CI: /tmp/secureagent
WORKSPACE_ROOT=D:\MEETmux\secureagent\workspaces

# ── LLM (Gemini) ─────────────────────────────────────────────────────────────
LLM_PROVIDER=google
LLM_TRIAGE_MODEL=gemini-2.0-flash
LLM_FIX_MODEL=gemini-2.5-pro
GOOGLE_API_KEY=

# ── Scan Limits ───────────────────────────────────────────────────────────────
MAX_REPO_SIZE_MB=100
MAX_FILES_TO_SCAN=1000
MAX_LLM_TOKENS_PER_SCAN=200000
MAX_FINDINGS_TO_FIX=10
MAX_PATCH_LINES=200
CONFIDENCE_THRESHOLD=0.7
AUTO_FIX_SEVERITIES=critical,high,medium
MAX_FIX_ATTEMPTS=3

# ── Concurrency & Timeouts ────────────────────────────────────────────────────
MAX_CONCURRENT_SCANS=3
SCAN_TIMEOUT_TOTAL=1800

# ── Docker Sandbox ────────────────────────────────────────────────────────────
SANDBOX_IMAGE=secureagent-sandbox:latest
SANDBOX_CPU=0.5
SANDBOX_MEMORY=512m
SANDBOX_TIMEOUT=120
SEMGREP_TIMEOUT=120

# ── Debug ─────────────────────────────────────────────────────────────────────
DEBUG=false
